{
  "expo": {
    "name": "CaddyAI",
    "slug": "caddyai",
    "scheme": "caddyai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.caddy.app"
    },
    "android": {
      "package": "ai.caddy.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E3B2E"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
